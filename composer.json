{
    "name": "asteriskpound/nativephp-mobile-charts",
    "description": "Hand-rolled line/bar/radar charts for NativePHP Mobile v4 — a <native:chart> EDGE element backed by SwiftUI Canvas (iOS) and Compose Canvas (Android). Community plugin, not affiliated with the NativePHP core team.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": ["nativephp", "chart", "line-chart", "bar-chart", "radar-chart", "canvas", "data-visualization"],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Asteriskpound\\NativePhpMobileCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asteriskpound\\NativePhpMobileCharts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asteriskpound\\NativePhpMobileCharts\\ChartsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
